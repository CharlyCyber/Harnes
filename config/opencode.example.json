{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  },
  "mcp": {
    "chrome-devtools": {"type": "local", "command": ["npx", "-y", "chrome-devtools-mcp@1.6.0"], "enabled": true},
    "context7": {"type": "local", "command": ["npx", "-y", "@upstash/context7-mcp@3.2.5"], "enabled": true}
  }
}
