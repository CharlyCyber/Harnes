{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny"
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@1.6.0"]
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp@3.2.5"]
      },
      "apify": {
        "type": "local",
        "command": ["npx", "-y", "@apify/actors-mcp-server@0.13.0"],
        "environment": {"APIFY_TOKEN": "{env:APIFY_TOKEN}"},
        "disabled": true
      }
    }
  }
}
